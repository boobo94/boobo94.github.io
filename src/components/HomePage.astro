---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostListItem from './PostListItem.astro';
import Pagination from './Pagination.astro';
import type { Post } from '../lib/posts';
import { site } from '../site.config';

interface Props {
  posts: Post[];
  page: number;
  totalPages: number;
}

const { posts, page, totalPages } = Astro.props;
---

<BaseLayout title={page > 1 ? `${site.title} - Page ${page}` : undefined}>
  {
    posts.length > 0 ? (
      <>
        <p class="prompt">
          <span class="sym">$</span>blog --latest
          <span class="dim">// page {page} of {totalPages}</span>
        </p>
        <div class="post-list" id="search-container" data-list>
          {posts.map((post) => (
            <PostListItem post={post} />
          ))}
        </div>
        <Pagination page={page} totalPages={totalPages} />
      </>
    ) : (
      <p class="prompt">
        <span class="sym">$</span>
        <span class="dim">{site.text.index.comingSoon}</span>
      </p>
    )
  }
</BaseLayout>
