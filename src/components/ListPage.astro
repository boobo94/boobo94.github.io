---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostListItem from './PostListItem.astro';
import type { Post } from '../lib/posts';

interface Props {
  title: string;
  prompt: string;
  description: string;
  posts: Post[];
  showCategories?: boolean;
}

const { title, prompt, description, posts, showCategories = true } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <header class="term-panel list-header">
    <p class="prompt"><span class="sym">$</span>{prompt}</p>
    <h1 class="list-title">{title}</h1>
    <p class="list-desc">// {description}</p>
  </header>
  <div class="post-list" id="search-container" data-list>
    {posts.map((post) => <PostListItem post={post} showCategories={showCategories} />)}
  </div>
</BaseLayout>
