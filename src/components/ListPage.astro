---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostListItem from './PostListItem.astro';
import type { Post } from '../lib/posts';

interface Props {
  title: string;
  prompt: string;
  description: string;
  posts: Post[];
  showCategories?: boolean;
}

const { title, prompt, description, posts, showCategories = true } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="home">
    <div class="cat-page-header">
      <p class="site-prompt" style="margin:0 0 .4rem;"><span class="sym">$</span> {prompt}</p>
      <h1 class="cat-page-title">{title}</h1>
      <p class="cat-page-desc">// {description}</p>
    </div>
    <div class="post-list" id="search-container">
      {posts.map((post, i) => <PostListItem post={post} index={i + 1} showCategories={showCategories} />)}
    </div>
  </div>
</BaseLayout>
