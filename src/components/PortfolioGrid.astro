---
import { getCollection } from 'astro:content';
import { portfolioUrl } from '../lib/urls';

const items = (await getCollection('portfolio')).sort((a, b) => a.id.localeCompare(b.id));
---

<div class="portfolio-grid">
  {
    items.map((item) => (
      <article class="portfolio-item panel">
        {item.data.cover && (
          <div class="cover">
            <img src={item.data.cover} alt="" loading="lazy" decoding="async" onerror="this.parentElement.remove()" />
          </div>
        )}
        <h3>
          <a href={portfolioUrl(item)}>{item.data.title}</a>
        </h3>
        <p>{item.data.summary}</p>
      </article>
    ))
  }
</div>
