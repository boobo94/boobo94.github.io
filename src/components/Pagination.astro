---
import { site } from '../site.config';

interface Props {
  page: number;
  totalPages: number;
}

const { page, totalPages } = Astro.props;
// jekyll-paginate URLs: "/", "/page2/", "/page3/", ...
const pageUrl = (n: number) => (n === 1 ? '/' : `/page${n}/`);
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="Pagination">
      {page > 1 ? (
        <a class="btn" href={pageUrl(page - 1)} rel="prev">
          ← {site.text.pagination.newer}
        </a>
      ) : (
        <span class="btn is-disabled" aria-hidden="true">
          ← {site.text.pagination.newer}
        </span>
      )}
      <span class="pagination-meta">
        Page {page} of {totalPages}
      </span>
      {page < totalPages ? (
        <a class="btn" href={pageUrl(page + 1)} rel="next">
          {site.text.pagination.older} →
        </a>
      ) : (
        <span class="btn is-disabled" aria-hidden="true">
          {site.text.pagination.older} →
        </span>
      )}
    </nav>
  )
}
