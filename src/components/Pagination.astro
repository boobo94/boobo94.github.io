---
import { site } from '../site.config';

interface Props {
  page: number;
  totalPages: number;
}

const { page, totalPages } = Astro.props;
// jekyll-paginate URLs: "/", "/page2/", "/page3/", ...
const pageUrl = (n: number) => (n === 1 ? '/' : `/page${n}/`);
---

{
  totalPages > 1 && (
    <div class="pagination clearfix mb1 mt4">
      <div class="left">
        {page > 1 ? (
          <a class="pagination-item" href={pageUrl(page - 1)}>{site.text.pagination.newer}</a>
        ) : (
          <span class="pagination-item disabled">{site.text.pagination.newer}</span>
        )}
      </div>
      <div class="right">
        {page < totalPages ? (
          <a class="pagination-item" href={pageUrl(page + 1)}>{site.text.pagination.older}</a>
        ) : (
          <span class="pagination-item disabled">{site.text.pagination.older}</span>
        )}
      </div>
      <div class="pagination-meta">Page {page} of {totalPages}</div>
    </div>
  )
}
