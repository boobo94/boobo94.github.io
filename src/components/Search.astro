---
// Pagefind-backed search. Results replace the contents of #search-container,
// matching the old simple-jekyll-search behaviour.
---

<script>
  type PagefindResult = { data: () => Promise<{ url: string; meta: Record<string, string>; excerpt: string }> };
  type Pagefind = { search: (q: string) => Promise<{ results: PagefindResult[] }> };

  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const container = document.getElementById('search-container');
  let pagefind: Pagefind | undefined;
  const original = container?.innerHTML ?? '';

  async function load(): Promise<Pagefind | undefined> {
    if (!pagefind) {
      try {
        const path = '/pagefind/pagefind.js';
        pagefind = await import(/* @vite-ignore */ path);
      } catch {
        console.warn('Search index not available (run `yarn build` to generate it).');
      }
    }
    return pagefind;
  }

  const esc = (s = '') =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  function render(r: { url: string; meta: Record<string, string>; excerpt: string }) {
    const { title = '', date = '', category = '' } = r.meta;
    return `<div class="post-list-item"><div class="post-list-inner"><div class="post-list-meta"><time class="post-list-date">${esc(date)}</time>${
      category ? `<a href="/${esc(category)}/" class="post-list-cat">/${esc(category)}</a>` : ''
    }</div><a href="${esc(r.url)}" class="post-list-link"><h2 class="post-list-title"><span class="list-arrow">&rsaquo;</span>${esc(
      title,
    )}</h2></a><p class="post-list-summary">${r.excerpt}</p></div></div>`;
  }

  let seq = 0;
  input?.addEventListener('input', async () => {
    if (!container) return;
    const q = input.value.trim();
    const mine = ++seq;
    if (!q) {
      container.innerHTML = original;
      return;
    }
    const pf = await load();
    if (!pf) return;
    const { results } = await pf.search(q);
    const data = await Promise.all(results.slice(0, 20).map((r) => r.data()));
    if (mine !== seq) return;
    container.innerHTML = data.length ? data.map(render).join('') : '<p class="post-list-summary">No results.</p>';
  });

  // Keyboard shortcut for search (Cmd/Ctrl + /)
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === '/') {
      e.preventDefault();
      input?.focus();
      input?.select();
    }
  });
</script>
