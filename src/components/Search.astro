---
// Pagefind-backed search. Results replace the contents of #search-container
// (the post list on list pages, the article on post pages).
---

<script>
  type ResultData = { url: string; meta: Record<string, string>; excerpt: string };
  type Pagefind = {
    search: (q: string) => Promise<{ results: { data: () => Promise<ResultData> }[] }>;
  };

  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const clear = document.querySelector<HTMLButtonElement>('.search-clear');
  const kbd = document.querySelector('.search-kbd');
  const container = document.getElementById('search-container');
  const original = container?.innerHTML ?? '';
  let pagefind: Pagefind | undefined;
  let seq = 0;

  if (kbd && /Mac|iPhone|iPad/.test(navigator.platform)) kbd.textContent = '⌘ /';

  async function load(): Promise<Pagefind | undefined> {
    if (!pagefind) {
      try {
        const path = '/pagefind/pagefind.js';
        pagefind = await import(/* @vite-ignore */ path);
      } catch {
        console.warn('Search index not available (run `yarn build` to generate it).');
      }
    }
    return pagefind;
  }

  const esc = (s = '') =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  function render(r: ResultData) {
    const { title = '', date = '', category = '' } = r.meta;
    const cat = category ? `<a href="/${esc(category)}/">/${esc(category)}</a>` : '';
    return `<article class="post-list-item"><div class="post-list-meta"><time>${esc(date)}</time>${cat}</div><h2 class="post-list-title"><a href="${esc(
      r.url,
    )}">${esc(title)}</a></h2><p class="post-list-summary">${r.excerpt}</p></article>`;
  }

  function reset() {
    if (!input || !container) return;
    seq++;
    input.value = '';
    clear?.setAttribute('hidden', '');
    container.innerHTML = original;
    container.classList.remove('post-list');
    if (container.dataset.list !== undefined) container.classList.add('post-list');
  }

  input?.addEventListener('input', async () => {
    if (!container) return;
    const q = input.value.trim();
    clear?.toggleAttribute('hidden', !input.value);
    if (!q) return reset();
    const mine = ++seq;
    const pf = await load();
    if (!pf) return;
    const { results } = await pf.search(q);
    const data = await Promise.all(results.slice(0, 20).map((r) => r.data()));
    if (mine !== seq) return;
    const count = results.length;
    const shown = count > data.length ? ` (showing ${data.length})` : '';
    container.classList.add('post-list');
    container.innerHTML =
      `<p class="search-status" role="status">${count} result${count === 1 ? '' : 's'} for “${esc(q)}”${shown}</p>` +
      data.map(render).join('');
  });

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      reset();
      input.blur();
    }
  });

  clear?.addEventListener('click', () => {
    reset();
    input?.focus();
  });

  // Keyboard shortcut for search (Cmd/Ctrl + /)
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === '/') {
      e.preventDefault();
      input?.focus();
      input?.select();
    }
  });
</script>
