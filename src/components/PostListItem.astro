---
import type { Post } from '../lib/posts';
import { excerpt, formatDate } from '../lib/posts';
import { categoryUrl, postUrl } from '../lib/urls';

interface Props {
  post: Post;
  showCategories?: boolean;
}

const { post, showCategories = true } = Astro.props;
---

<article class="post-list-item">
  <div class="post-list-meta">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    {showCategories && post.data.categories.map((c) => <a href={categoryUrl(c)}>/{c}</a>)}
  </div>
  <h2 class="post-list-title"><a href={postUrl(post)}>{post.data.title}</a></h2>
  <p class="post-list-summary">{excerpt(post)}</p>
</article>
