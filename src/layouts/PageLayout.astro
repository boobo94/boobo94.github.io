---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  robots?: string;
}

const { title } = Astro.props;
---

<BaseLayout {...Astro.props}>
  <div class="post">
    <header class="post-header">
      <h1 class="h2">{title}</h1>
    </header>
    <article class="post-content">
      <slot />
    </article>
  </div>
</BaseLayout>
