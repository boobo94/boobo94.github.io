---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  robots?: string;
}

const { title } = Astro.props;
---

<BaseLayout {...Astro.props}>
  <h1 class="page-title">{title}</h1>
  <article class="post-content">
    <slot />
  </article>
</BaseLayout>
