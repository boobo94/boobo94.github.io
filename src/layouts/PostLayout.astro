---
import type { MarkdownHeading } from 'astro';
import { Icon } from 'astro-icon/components';
import BaseLayout from './BaseLayout.astro';
import ShareButtons from '../components/ShareButtons.astro';
import PostFooter from '../components/PostFooter.astro';
import PostListItem from '../components/PostListItem.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { formatDate, readingTime, relatedPosts, type Post } from '../lib/posts';
import { categoryUrl, postUrl, tagUrl } from '../lib/urls';
import { site } from '../site.config';

interface Props {
  post: Post;
  all: Post[];
  headings: MarkdownHeading[];
}

const { post, all, headings } = Astro.props;
const d = post.data;
const body = post.body ?? '';
const related = relatedPosts(post, all, 4);
const url = new URL(postUrl(post), site.url).href;
// Skip the generated contents list when the post already has a hand-written one.
const hasManualToc = (body.match(/\]\(#/g) ?? []).length >= 3;
---

<BaseLayout title={d.title} description={d.meta_description || d.summary} image={d.cover} canonical={d.canonical_url} keywords={d.keywords}>
  <div class="reading-progress" aria-hidden="true"></div>

  <div id="search-container">
    <header class="term-panel post-header">
      <div class="post-breadcrumb">
        <span class="sym" aria-hidden="true">$</span>
        {
          d.categories.map((c, i) => (
            <>
              <a href={categoryUrl(c)}>/{c}</a>
              {i < d.categories.length - 1 && <span aria-hidden="true">/</span>}
            </>
          ))
        }
      </div>

      <h1 class="post-title" data-pagefind-meta="title">{d.title}</h1>
      <span hidden data-pagefind-meta={`date:${formatDate(d.date)}`}></span>
      {d.categories[0] && <span hidden data-pagefind-meta={`category:${d.categories[0]}`}></span>}

      <div class="post-meta">
        <span class="label">published</span>
        <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
        {
          d.update_date && (
            <>
              <span class="sep" aria-hidden="true">·</span>
              <span class="label">updated</span>
              <time datetime={d.update_date.toISOString()}>{formatDate(d.update_date)}</time>
            </>
          )
        }
        <span class="sep" aria-hidden="true">·</span>
        <span>{readingTime(post)} {site.text.post.minuteRead}</span>
        {
          d.tags.length > 0 && (
            <>
              <span class="sep" aria-hidden="true">·</span>
              {d.tags.map((t) => (
                <a href={tagUrl(t)} class="tag">
                  {t}
                </a>
              ))}
            </>
          )
        }
      </div>
    </header>

    {!hasManualToc && <TableOfContents headings={headings} />}

    <article class="post-content" data-pagefind-body>
      {
        d.cover && (
          <img src={d.cover} alt="" class="post-cover-img" width="1280" height="720" decoding="async" fetchpriority="high" onerror="this.remove()" />
        )
      }
      <slot />
    </article>

    <ShareButtons title={d.title} url={url} />
    <PostFooter />

    {
      related.length > 0 && (
        <section class="related-posts" aria-labelledby="related-title">
          <p class="prompt" id="related-title">
            <span class="sym">$</span>
            {site.text.post.relatedPosts.toLowerCase()}
          </p>
          <div class="post-list">
            {related.map((p) => (
              <PostListItem post={p} />
            ))}
          </div>
        </section>
      )
    }
  </div>

  <button type="button" class="back-to-top" aria-label="Back to top">
    <Icon name="lucide:arrow-up" />
  </button>
</BaseLayout>

<script>
  // Copy buttons on code blocks.
  document.querySelectorAll<HTMLPreElement>('.post-content pre').forEach((pre) => {
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    pre.replaceWith(wrapper);
    wrapper.append(pre);

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-code';
    button.textContent = 'Copy';
    button.setAttribute('aria-label', 'Copy code to clipboard');
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ''));
        button.textContent = 'Copied';
        button.classList.add('is-copied');
      } catch {
        button.textContent = 'Press Ctrl+C';
      }
      setTimeout(() => {
        button.textContent = 'Copy';
        button.classList.remove('is-copied');
      }, 2000);
    });
    wrapper.append(button);
  });

  // Reading progress bar + back-to-top button.
  const bar = document.querySelector<HTMLElement>('.reading-progress');
  const article = document.querySelector<HTMLElement>('.post-content');
  const top = document.querySelector<HTMLButtonElement>('.back-to-top');
  let ticking = false;
  const update = () => {
    ticking = false;
    if (article && bar) {
      const start = article.offsetTop;
      const end = start + article.offsetHeight - window.innerHeight;
      const progress = end > start ? (window.scrollY - start) / (end - start) : 1;
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, progress))})`;
    }
    top?.classList.toggle('is-visible', window.scrollY > window.innerHeight);
  };
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );
  update();
  top?.addEventListener('click', () => {
    const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: smooth ? 'smooth' : 'auto' });
    document.querySelector<HTMLElement>('.site-brand')?.focus({ preventScroll: true });
  });
</script>
